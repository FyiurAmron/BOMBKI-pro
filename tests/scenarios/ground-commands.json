{
  "steps": [
    {
      "label": "intro prompt",
      "expect": "DUŻO POPRAWEK WIĘC SIĘ CIESZ I GRAJ"
    },
    {
      "label": "player-name prompt",
      "expect": "A TWOJE IMIĘ TO",
      "send": "TESTER"
    },
    {
      "label": "race prompt",
      "expect": "NAPISZ SWĄ RASĘ",
      "send": "POL-ELF"
    },
    {
      "label": "first room",
      "expect": "TU ZACZYNA SIĘ GRĘ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "ground prompt",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ KASE"
    },
    {
      "label": "grant one",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ KASE"
    },
    {
      "label": "grant two",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ KASE"
    },
    {
      "label": "restored salon",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "city centre",
      "expect": "JESTEŚ W CENTRUM MIASTA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "shopping street",
      "expect": "JESTEŚ NA ULICY NA ULICY SKLEPIKOWEJ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "ZACHOD"
    },
    {
      "label": "armoury",
      "expect": "JESTEŚ W ZBROJOWNI[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "KUP STARY"
    },
    {
      "label": "buy sword",
      "expect": "KUPUJESZ ZWYKŁY MAŁY[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "KUP MALA"
    },
    {
      "label": "buy shield",
      "expect": "KUPUJESZ !MAŁA! TARCZA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "WSCHOD"
    },
    {
      "label": "ground prompt again",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "ODRZUC STARY"
    },
    {
      "label": "sword dropped",
      "expect": "ODRZUCASZ STARY ZARDZEWIAŁY MIECZ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "ODRZUC MALA"
    },
    {
      "label": "step out to the armoury",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "ZACHOD"
    },
    {
      "label": "armoury",
      "expect": "JESTEŚ W ZBROJOWNI",
      "send": "WSCHOD"
    },
    {
      "label": "re-enter ground, both items announced",
      "expect": "W TWYM POKOJU LEŻY !STARY![\\s\\S]*?W TYM POKOJU ZNAJDUJE SIĘ !MAŁA! TARCZA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "BIERZ STARY"
    },
    {
      "label": "pick the sword back up",
      "expect": "PODNOSISZ STARY ZARDZEWIAŁY MIECZ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "BIERZ MALA"
    },
    {
      "label": "pick the shield back up",
      "expect": "PODNOSISZ MAŁA TARCZA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "UZYJ STARY"
    },
    {
      "label": "equip the sword",
      "expect": "UŻYWASZ STAREGO ZARDZEWIAŁEGO MIECZA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "ODLOZ STARY"
    },
    {
      "label": "stow sword",
      "expect": "CHOWASZ STARY ZARDZEWIAŁY MIECZ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "UZYJ MALA"
    },
    {
      "label": "equip shield",
      "expect": "UŻYWASZ MAŁEJ TARCZY JAKO TARCZY[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "ODLOZ MALA"
    },
    {
      "label": "stow shield",
      "expect": "JUŻ NIE UŻYWASZ MAŁEJ TARCZY[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "USTAW SZ"
    },
    {
      "label": "reset gear stats",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "ZDEJMUJ"
    },
    {
      "label": "take off gear",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ EN"
    },
    {
      "label": "restore energy",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "ZABIERAJ KASE"
    },
    {
      "label": "lose coins",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "SCAN"
    },
    {
      "label": "scan future function",
      "expect": "FUNKCJA BĘDZIE DOSTĘPNA ZA DWA LATA[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "ODRZUC PACZEK"
    },
    {
      "label": "refuse to drop food",
      "expect": "JAK ŚMIESZ WYRZUCAĆ JEDZENIE[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "JA"
    },
    {
      "label": "character sheet",
      "expect": "W SUMIE MASZ[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "EXIT"
    },
    {
      "label": "restored street",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "WYJSCIE"
    }
  ]
}
