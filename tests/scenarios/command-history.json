{
  "steps": [
    {
      "label": "intro prompt",
      "expect": "Dużo\\ poprawek\\ więc\\ się\\ ciesz\\ i\\ graj"
    },
    {
      "label": "player-name prompt",
      "expect": "A\\ twoje\\ imię\\ to",
      "send": "TESTER"
    },
    {
      "label": "race prompt",
      "expect": "Napisz\\ swą\\ rasę",
      "send": "OLBRZYM"
    },
    {
      "label": "first room",
      "expect": "Tu\\ zaczyna\\ się\\ grę[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "EXIT"
    },
    {
      "label": "exit list",
      "expect": "Dostępne\\ WYJŚCIA:[\\s\\S]*?PÓŁNOC:\\ Pokój\\ centralny[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "\u001b[A"
    },
    {
      "label": "up arrow recalls EXIT",
      "expect": "Dostępne\\ WYJŚCIA:[\\s\\S]*?PÓŁNOC:\\ Pokój\\ centralny[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "JA",
      "append_newline": false
    },
    {
      "label": "the draft is echoed",
      "expect": "JA",
      "send": "\u001b[A",
      "append_newline": false
    },
    {
      "label": "up arrow shows the recalled line",
      "expect": "EXIT",
      "send": "\u001b[B",
      "append_newline": false
    },
    {
      "label": "down arrow restores the draft",
      "expect": "JA",
      "send": ""
    },
    {
      "label": "the sheet opens",
      "expect": "Nazwałeś\\ się\\ TESTER[\\s\\S]*?Nosisz\\ ze\\ sobą[\\s\\S]*?[0-9]+%\\.-?[0-9]+>",
      "send": "WYJSCIE"
    },
    {
      "label": "the game ends",
      "expect_exit": true
    }
  ]
