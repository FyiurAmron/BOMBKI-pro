    {
      "label": "empty pill sale is refused",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "JA"
    },
    {
      "label": "sheet: no pill",
      "expect": "W\\ sumie\\ masz\\ 0/10\\ przedmiotów"
    },
    {
      "label": "sheet: the pill sale did not pay",
      "expect": "Masz\\ 4993\\ MONET\\ i\\ 10\\ PRAKTYK",
      "send": "WYJSCIE"
