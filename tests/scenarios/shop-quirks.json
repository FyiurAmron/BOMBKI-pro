    },
    {
      "label": "ground prompt after the cheat",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "KUP MALA"
    },
    {
      "label": "buy the shield",
      "expect": "Kupujesz\\ !MAŁA!\\ Tarcza[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "SPRZEDAJ MALA"
    },
    {
      "label": "sell the owned shield",
      "expect": "Ta\\ tarcza\\ jest\\ bajer[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "SPRZEDAJ MALA"
    },
    {
      "label": "second shield sale is refused",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "JA"
    },
    {
      "label": "sheet: the shield is gone",
      "expect": "W\\ sumie\\ masz\\ 0/10\\ przedmiotów"
    },
    {
      "label": "sheet: money after buy and sell",
      "expect": "Masz\\ 4993\\ MONET\\ i\\ 10\\ PRAKTYK",
      "send": "EXIT"
    },
    {
      "label": "armoury exits",
      "expect": "Dostępne\\ WYJŚCIA:[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "WSCHOD"
    },
    {
      "label": "back on the south street",
      "expect": "Jesteś\\ na\\ ulicy\\ na\\ ulicy\\ Sklepikowej[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "shopping street north",
      "expect": "Ciągnie\\ się\\ tędy\\ ulica\\ Sklepikowa[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "ZACHOD"
    },
    {
      "label": "magic shop",
      "expect": "Wchodzisz\\ do\\ sklepu\\ ale\\ niczego[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "SPRZEDAJ PIGULKA TRANSPORTUJACA"
