{
  "steps": [
    {
      "label": "intro prompt",
      "expect": "Dużo\\ poprawek\\ więc\\ się\\ ciesz\\ i\\ graj"
    },
    {
      "label": "player-name prompt",
      "expect": "A\\ twoje\\ imię\\ to",
      "send": "TESTER"
    },
    {
      "label": "race prompt",
      "expect": "Napisz\\ swą\\ rasę",
      "send": "OLBRZYM"
    },
    {
      "label": "start room, head for the salon",
      "expect": "Tu\\ zaczyna\\ się\\ grę[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "ground, take the cash",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ KASE"
    },
    {
      "label": "ground, energy +200",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ EN"
    },
    {
      "label": "ground, energy +400",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ EN"
    },
    {
      "label": "ground, energy +600",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "DAWAJ EN"
    },
    {
      "label": "salon, head for the city centre",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "city centre, head for ulica sklepikowa",
      "expect": "Jesteś\\ w\\ centrum\\ miasta[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "ulica sklepikowa, keep going north",
      "expect": "Jest\\ tu\\ parę\\ sklepików[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "ulica sklepikowa, head for the general store",
      "expect": "Ciągnie\\ się\\ tędy\\ ulica\\ Sklepikowa[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "WSCHOD"
    },
    {
      "label": "general store, buy the fajka",
      "expect": "Wszedłeś\\ do\\ sklepu\\ wielobranżowego[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "KUP FAJKA"
    },
    {
      "label": "ground, drop the fajka",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "ODRZUC FAJKA"
    },
    {
      "label": "back in the store, leave the game",
      "expect": "[0-9]+%\\.-?[0-9]+>",
      "send": "WYJSCIE"
    },
    {
      "label": "the game ends",
      "expect_exit": true
    }
  ]
}
