    },
    {
      "label": "race prompt",
      "expect": "Napisz\\ swą\\ rasę",
      "send": "UFOK"
    },
    {
      "label": "first room",
      "expect": "Tu\\ zaczyna\\ się\\ grę[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "POLNOC"
    },
    {
      "label": "salon, into the strength room",
      "expect": "Jesteś\\ w\\ okrągłym\\ salonie[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "WSCHOD"
    },
    {
      "label": "strength room",
      "expect": "Jesteś\\ w\\ pokoju\\ gdzie\\ Rambo\\ trenuje[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "TRENUJ ZRECZNOSC"
    },
    {
      "label": "train agility to 10",
      "expect": "Trenujesz\\ ZRECZNOSC\\ i\\ masz\\ 10[\\s\\S]*?[0-9]+%\\.\\-?[0-9]+>",
      "send": "TRENUJ ZRECZNOSC"
